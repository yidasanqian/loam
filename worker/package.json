{
  "name": "@loam/worker",
  "private": true,
  "version": "0.4.0",
  "description": "loam Cloudflare Worker: D1-backed project memory API.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run db:init:remote && npm run db:apply:remote && wrangler deploy",
    "db:init": "wrangler d1 execute loam --file=./schema.sql --local",
    "db:init:remote": "wrangler d1 execute DB --remote --file=./schema.sql -y",
    "db:apply": "node ../scripts/apply-d1-migrations.mjs --local",
    "db:apply:remote": "node ../scripts/apply-d1-migrations.mjs --remote",
    "test": "vitest run",
    "test:offline": "node --experimental-strip-types --test test/offline/core.test.ts test/offline/migrations.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "首次注册（/v1/activate）用。生成：`node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"`"
      }
    }
  }
}
