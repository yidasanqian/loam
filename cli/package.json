{
  "name": "@yidasanqian/loam",
  "version": "0.3.1",
  "description": "loam: single-user project memory shared across devices and agent harnesses",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidasanqian/loam.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/yidasanqian/loam#readme",
  "bugs": {
    "url": "https://github.com/yidasanqian/loam/issues"
  },
  "type": "module",
  "bin": {
    "loam": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/node/blocks.test.ts test/node/format.test.ts test/node/git.test.ts test/node/outbox.test.ts test/node/project.test.ts test/node/install.test.ts test/node/client.test.ts test/node/upgrade.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "project-memory",
    "agent-memory",
    "claude-code",
    "codex",
    "dsh",
    "ai-agents",
    "cli",
    "cloudflare-workers",
    "d1",
    "skills"
  ]
}
